# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Leave empty or default to auto-use in-memory MongoDB for instant zero-config setup)
MONGODB_URI=mongodb://localhost:27017/sales_intelligence

# JWT Secret for User Authentication
JWT_SECRET=super_secret_sales_ai_jwt_key_2026_production_ready
JWT_EXPIRES_IN=7d

# AI API Keys (Optional - Intelligent fallback simulation active when not set)
# Google Gemini API Key
GEMINI_API_KEY=
# OpenAI API Key (For Whisper Speech-to-Text & GPT-4o analysis)
OPENAI_API_KEY=

# Upload Config
MAX_FILE_SIZE_MB=50
